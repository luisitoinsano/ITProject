# HELP: sincronizar local == remoto con Git LFS (PowerShell en raíz del repo)
# 1) (Opcional) asegurar carpetas no vacías:
#    ni memes\.gitkeep -ItemType file; ni snapshots\.gitkeep -ItemType file
# 2) Confirmar cambios:
#    git add -A && git commit -m "chore: update"
# 3) LFS y migración del historial:
#    git lfs install
#    py -m pip install git-filter-repo
#    git lfs migrate import --include="detector_emociones/**,memes/**,snapshots/**,*.dll,*.pyd,*.exe,*.so,*.dylib,*.bin,*.pb,*.tflite,*.onnx,*.mp4,*.mov,*.webm,*.gif,*.jpg,*.jpeg,*.png,*.webp,*.bmp,*.JPG,*.JPEG,*.PNG,*.WEBP,*.BMP,*.GIF,*.MP4,*.MOV,*.WEBM" --everything
# 4) Subir:
#    git push --force origin main
#    git lfs push --all origin main
# 5) Verificar:
#    git lfs ls-files
